# Public/local development configuration only. Never put secrets in this file.
SANTO_ENV=local
VITE_SANTO_API_BASE_URL=http://localhost:8787

# WorkOS AuthKit access-token verification. Replace with non-secret development IDs/URLs.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_ISSUER=https://api.workos.com
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me

# Comma-separated WorkOS user IDs allowed to bootstrap Santo Super Admin actions.
# Use repository/deployment secrets or environment configuration for real IDs.
SANTO_SUPER_ADMIN_USER_IDS=user_replace_me
